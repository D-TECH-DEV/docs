  "keyFeatures": [
    "JWT-based authentication with email verification",
    "Google OAuth2 login support",
    "Client management (create, update, delete, list)",
    "Invoice management with line items and status tracking",
    "PDF invoice generation with custom branding options",
    "AI-powered invoice generation from natural language descriptions (Google Gemini)",
    "Public shareable invoice links via unique tokens",
    "Password reset via email OTP flow"
  ],
  "publicApiSurface": [
    "POST /api/auth/register",
    "POST /api/auth/login",
    "GET /api/auth/verify?token={token}",
    "POST /api/auth/confirm-pwd/{email}",
    "POST /api/auth/reset-pwd",
    "POST /api/clients",
    "GET /api/clients/me",
    "PUT /api/clients/{id}",
    "DELETE /api/clients/{id}",
    "GET /api/invoices",
    "GET /api/invoices/{id}",
    "GET /api/invoices/me",
    "POST /api/invoices",
    "PUT /api/invoices/{id}",
    "DELETE /api/invoices/{id}",
    "GET /api/invoices/{id}/pdf",
    "GET /api/invoices/ai?description={text}&lang={lang}&devise={currency}",
    "GET /api/ia/invoice?description={text}&lang={lang}",
    "GET /api/i/{token}"
  ]
}
